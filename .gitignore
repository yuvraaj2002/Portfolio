# Generated VO / media (keep public/vo/.gitkeep; samples stay local for listening)
launch-video/public/vo/**
!launch-video/public/vo/.gitkeep
launch-video/public/**/*.mp3
launch-video/public/**/*.wav
launch-video/public/**/*.m4a
launch-video/public/**/*.aac
launch-video/public/**/*.flac
launch-video/**/*.mp4
launch-video/**/*.mov
launch-video/**/*.webm
launch-video/**/*.mkv
# Exception: allow committing a small quality-preview folder if desired later
# (default: ignored — generate with npm run tts:sample)

# Working copies (examples stay tracked)
launch-video/segments.json
launch-video/storyboard.json
launch-video/*.wav
launch-video/*.mp3
launch-video/audio_*.wav
launch-video/audio_*.mp3

# Copied site assets / generated stills (not source)
