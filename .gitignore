# ---------------------------------------------------------------------------
# launch-video/ — keep scripts + README tracked; ignore local/runtime junk
# ---------------------------------------------------------------------------
launch-video/.venv/
launch-video/venv/
launch-video/node_modules/
launch-video/package-lock.json
launch-video/.env
launch-video/.env.*
!launch-video/.env.example
launch-video/out/
launch-video/build/
launch-video/dist/
launch-video/.remotion/
launch-video/.cache/
launch-video/__pycache__/
launch-video/**/__pycache__/
launch-video/*.pyc
launch-video/.pytest_cache/
launch-video/.mypy_cache/
launch-video/.ruff_cache/
