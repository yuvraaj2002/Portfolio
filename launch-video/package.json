{
  "name": "portfolio-launch-video",
  "private": true,
  "type": "module",
  "description": "Remotion + local Kokoro (mlx-audio) TTS workspace for Yuvraj Singh portfolio launch films",
  "scripts": {
    "tts": "node scripts/generate-vo.mjs",
    "tts:kokoro": "node scripts/generate-vo.mjs --provider kokoro",
    "tts:gemini": "node scripts/generate-vo.mjs --provider gemini",
    "tts:help": "node scripts/generate-vo.mjs --help",
    "tts:sample": "node scripts/generate-vo.mjs --provider kokoro --segments samples/sample-segments.json --output-dir public/vo/samples",
    "studio": "remotion studio",
    "render": "remotion render ThemeToggleNightOwls out/theme-toggle-night-owls.mp4 --codec h264 --crf 18",
    "still": "remotion still ThemeToggleNightOwls"
  },
  "optionalDependencies": {
    "@google/genai": "^3.6.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.545",
    "@remotion/google-fonts": "^4.0.545",
    "@remotion/media": "^4.0.545",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
